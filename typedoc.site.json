{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/lib/index.ts",
    "src/lib/loaders.ts",
    "src/lib/static-lod-entry.ts",
    "src/lib/streaming.ts",
    "src/lib/unified.ts",
    "src/lib/selection.ts",
    "src/lib/formats/ply/index.ts",
    "src/lib/formats/sog/index.ts",
    "src/lib/formats/rad/index.ts",
    "src/lib/formats/lcc/index.ts",
    "src/lib/formats/spz/index.ts",
    "src/lib/formats/splat/index.ts",
    "src/lib/formats/ksplat/index.ts",
    "src/lib/effects.ts"
  ],
  // Keep the reading order above (index, optional subpaths, formats, effects)
  // instead of TypeDoc's alphabetical default.
  "sortEntryPoints": false,
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "site/api",
  "docsRoot": "site",
  "readme": "none",
  "name": "@voluma/vlam",
  "excludeInternal": true,
  "excludePrivate": true,
  "hideGenerator": true,
  "skipErrorChecking": true,
  "cleanOutputDir": true,
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/Voluma-ai/vlam/blob/main/{path}#L{line}",
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  }
}
